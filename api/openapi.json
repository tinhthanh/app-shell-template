{
  "openapi": "3.1.0",
  "info": {
    "title": "App Shell API",
    "version": "1.0.0",
    "description": "What the app's HTTP client (src/lib/api.ts) asks of a server, and what the mock (src/lib/mock.ts) answers. Each operationId is a method of Client. `pnpm check:contract` holds the client and the mock to this file; `pnpm stub` serves it from the mock. Replace the projects with your resources, here first. Every write (POST, PATCH, DELETE) carries X-Requested-With: XMLHttpRequest; a server using the session cookie refuses a write without it (cross-site request forgery)."
  },
  "paths": {
    "/projects": {
      "get": {
        "operationId": "projects",
        "summary": "A page of the projects that match, filtered and sorted by the server",
        "responses": {
          "200": {
            "description": "A page",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Project"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workspace",
            "in": "query",
            "required": false,
            "description": "The workspace to list; all when left out",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words to match in a name, a description or an owner",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "$ref": "#/components/schemas/ProjectStatus"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "description": "Comma-separated: a project wearing every one",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "name:asc, updated:desc\u2026",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Where the page starts (Page.next)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "operationId": "createProject",
        "summary": "Make a project",
        "responses": {
          "200": {
            "description": "The project made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "workspace": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "operationId": "project",
