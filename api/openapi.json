    "/tasks": {
      "get": {
        "operationId": "tasks",
        "summary": "A page of the tasks that match, filtered and sorted by the server",
        "responses": {
          "200": {
            "description": "A page",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Page"
                    },
                    {
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Task"
                          }
                        },
                        "summary": {
                          "type": "object",
                          "required": [
                            "late"
                          ],
                          "properties": {
                            "late": {
                              "type": "integer",
                              "minimum": 0,
                              "description": "Past their day and not done"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "summary"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "workspace",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words in a title or its project's name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "$ref": "#/components/schemas/TaskStatus"
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "A project's tasks, by its id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hideDone",
            "in": "query",
            "required": false,
            "description": "true leaves out the done tasks",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "title:asc, due:asc, updated:desc\u2026",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "operationId": "createTask",
        "summary": "Make a task",
        "responses": {
          "200": {
            "description": "The task made",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "$ref": "#/components/schemas/TaskStatus"
                  },
                  "due": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "project": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "A project's id in the task's workspace"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attachment": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "A file's id (POST /files)"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "workspace": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "operationId": "task",
        "summary": "One task",
        "responses": {
          "200": {
            "description": "The task",
