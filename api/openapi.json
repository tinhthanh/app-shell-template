      "delete": {
        "operationId": "deleteTask",
        "summary": "Delete a task",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/files": {
      "post": {
        "operationId": "uploadFile",
        "summary": "Keep a file, sent as it is; a task names it by the id answered",
        "responses": {
          "200": {
            "description": "The file kept",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attachment"
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-File-Name",
            "in": "header",
            "required": true,
            "description": "The file's name, URI-encoded",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "*/*": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "active",
          "paused",
          "archived"
        ]
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "workspace",
          "name",
          "description",
          "status",
          "owner",
          "tags",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "workspace": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "owner": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "next": {
            "type": "string",
            "description": "Where the next page starts; absent on the last"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "object",
            "description": "What the server worked out over every match, not only this page; each list says its own fields"
          }
        },
        "additionalProperties": false
      },
