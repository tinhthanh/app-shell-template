                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "operationId": "updateTask",
        "summary": "Change a task; null takes a due day, a project or a file off",
        "responses": {
          "200": {
            "description": "The task as saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "default": {
            "description": "A refusal or a failure, in the app's words (lib/api.ts errorBody)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "$ref": "#/components/schemas/TaskStatus"
                  },
                  "due": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "project": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "A project's id in the task's workspace"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attachment": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "A file's id (POST /files)"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "workspace": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
