# Where the HTTP client sends requests (src/lib/api.ts). Leave it unset to
# run on the mock fixtures (the same as ?mock=1). ?api=<url> in the page's
# URL wins over this.
# VITE_API_URL=http://localhost:8080

# The dev server's port (vite.config.ts); 1420 unless set.
# PORT=1420

# The rest are URL knobs, not env: ?mock=1, ?slow=1, ?fail=1, ?failOnce=1,
# ?failWrites=1, ?empty=1, ?crash=<view>, ?platform=mac|linux. The browser
# suite reads E2E_PORT, E2E_WORKERS, E2E_REPORT and A11Y_FULL; check:themes
# reads THEME_REPORT=1. docs/architecture.md has the table.
