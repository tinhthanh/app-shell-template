# Where the HTTP client sends requests (src/lib/api.ts). Leave it unset to
# run on the mock fixtures (the same as ?mock=1). ?api=<url> in the page's
# URL wins over this.
# VITE_API_URL=http://localhost:8080
# The same, set after the build: apiUrl in public/config.js (docs/deploy.md).

# VITE_KNOBS=1 keeps the URL knobs (?mock=1, ?api=, ?flags=, ?crash=) in a
# production build, for a demo site. Never on a build that talks to a real API.
# VITE_KNOBS=1

# The dev server's port (vite.config.ts); 1420 unless set.
# PORT=1420

# The rest are URL knobs, not env:
#   while the knobs are on (dev, or VITE_KNOBS=1): ?mock=1, ?api=<url> (this
#     origin or localhost), ?flags=a,-b (src/lib/flags.ts), ?crash=<view>
#     (also on the fixtures);
#   on the fixtures (src/lib/mock.ts fromUrl): ?slow=1, ?fail=1, ?failOnce=1,
#     ?failAfter=<n>, ?failWrites=1, ?failMore=1, ?hold=1, ?empty=1, ?many=1,
#     ?signedOut=1, ?sessionMinutes=<n>, ?role=owner|member|viewer;
#   always (src/lib/platform.ts): ?platform=mac|linux, ?dir=rtl|ltr.
# The browser suite reads E2E_PORT, E2E_WORKERS, E2E_REPORT and A11Y_FULL;
# check:themes reads THEME_REPORT=1. docs/architecture.md has the table.
