#!/bin/sh
# Staged files are formatted and linted, and no title= slipped in. Fast,
# so it runs on every commit; pnpm check runs before a push.
set -e
if [ -x node_modules/.bin/biome ]; then
  # Format in place and re-stage, so a shell edit lands formatted too.
  node_modules/.bin/biome check --write --staged --no-errors-on-unmatched
  git diff --name-only --cached --diff-filter=ACMR | xargs -r git add --
fi
node scripts/check-titles.mjs
