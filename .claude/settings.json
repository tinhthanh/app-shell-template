{
  "permissions": {
    "allow": [
      "Bash(npx pnpm@11 *)",
      "Bash(pnpm *)",
      "Bash(node --experimental-strip-types *)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(lsof -nP -iTCP:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(kill -9 *)",
      "Bash(lsof -ti:1420*)",
      "Bash(rm -rf node_modules*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format-file.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/stop-check.mjs", "timeout": 600 }]
      }
    ]
  }
}
