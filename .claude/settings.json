{
  "permissions": {
    "allow": [
      "Bash(npx pnpm@11 *)",
      "Bash(pnpm *)",
      "Bash(E2E_PORT=* pnpm *)",
      "Bash(A11Y_FULL=* pnpm *)",
      "Bash(THEME_REPORT=* pnpm *)",
      "Bash(CI=true pnpm install*)",
      "Bash(node --experimental-strip-types *)",
      "Bash(node scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git stash*)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(lsof -nP -iTCP:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(kill -9 *)",
      "Bash(lsof -ti:1420*)",
      "Bash(rm -rf node_modules*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/around-bash.mjs before"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/after-edit.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/around-bash.mjs after",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-check.mjs",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
