{
  "name": "app-shell-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "check:titles": "node scripts/check-titles.mjs",
    "check:themes": "node --experimental-strip-types --test src/themes/contrast.test.ts",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"src/themes/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80 --test \"src/lib/**/*.test.ts\" \"src/themes/*.test.ts\"",
    "test:e2e": "tsc --noEmit -p e2e && pnpm -s build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm check:titles && pnpm check:node && pnpm check:views && pnpm check:themes && pnpm test && pnpm build",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "check:node": "node scripts/check-node-imports.mjs",
    "check:views": "node scripts/check-views.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
