{
  "name": "app-shell-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "check:titles": "node scripts/check-titles.mjs",
    "check:themes": "node --experimental-strip-types --test src/themes/contrast.test.ts",
    "test": "node --experimental-strip-types --test src/lib/sidebar-width.test.ts src/lib/last-of.test.ts src/lib/poll.test.ts src/lib/prefs.test.ts src/lib/mock.test.ts",
    "test:e2e": "tsc --noEmit -p e2e && pnpm -s build && playwright test",
    "check": "pnpm typecheck && pnpm check:titles && pnpm check:themes && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
